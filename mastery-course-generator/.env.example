# =============================================================================
# Mastery Course Generator — environment configuration
# =============================================================================
# Copy to `.env` and fill in real values:   cp .env.example .env
# `.env` is gitignored. NEVER commit secrets.
#
# Every AI credential below is read SERVER-SIDE ONLY. None of these are
# prefixed with NEXT_PUBLIC_, so Next.js will never expose them to the browser.
# =============================================================================

# --- FCC Server / NVIDIA NIM -------------------------------------------------
# Base URL of the OpenAI-compatible endpoint that serves the NVIDIA NIM models.
#
# Two supported topologies:
#   1. Direct NIM upstream (what the FCC server itself proxies to):
#        FCC_SERVER_BASE_URL="https://integrate.api.nvidia.com/v1"
#   2. Through a locally running FCC server (free_claude_code) that fronts NIM.
#      Use its OpenAI-compatible base and the FCC-style prefixed model slugs
#      (e.g. "nvidia_nim/nvidia/nemotron-3-super-120b-a12b"):
#        FCC_SERVER_BASE_URL="http://127.0.0.1:8080/v1"
FCC_SERVER_BASE_URL="https://integrate.api.nvidia.com/v1"

# API key for the endpoint above. For the direct NIM upstream this is your
# NVIDIA `nvapi-...` key. Server-side only; never sent to the browser.
FCC_SERVER_API_KEY=""

# --- Model routing -----------------------------------------------------------
# Each pipeline stage can target a different NIM model. All are optional and
# fall back to the values shown. Model ids must exist on FCC_SERVER_BASE_URL
# (verify with `npm run nim:probe`).

# Default text/reasoning model. Used for any stage without a specific override.
NVIDIA_NIM_MODEL="nvidia/nemotron-3-super-120b-a12b"

# Multimodal model for syllabus photos / screenshots / scanned pages.
NVIDIA_NIM_VISION_MODEL="meta/llama-3.2-90b-vision-instruct"

# Embedding model. Only used when NIM_ENABLE_EMBEDDINGS=true.
NVIDIA_NIM_EMBEDDING_MODEL="nvidia/nv-embedqa-mistral-7b-v2"

# Optional per-stage overrides. Leave blank to use NVIDIA_NIM_MODEL.
# Curriculum planning / prerequisite reasoning (benefits from a stronger model):
NIM_MODEL_PLANNING=""
# Lesson + practice prose generation:
NIM_MODEL_GENERATION=""
# Assessment + answer-key generation:
NIM_MODEL_ASSESSMENT=""
# Independent QA validation pass (should ideally differ from the generator):
NIM_MODEL_QA=""

# Embeddings are off by default: they add cost and are not required for the
# core pipeline. Set to "true" to enable semantic duplicate detection in QA.
NIM_ENABLE_EMBEDDINGS="false"

# --- AI runtime behaviour ----------------------------------------------------
# Attempts per structured call (attempt 1 + schema-repair retries).
AI_MAX_RETRIES="3"
# Per-request timeout, milliseconds.
AI_REQUEST_TIMEOUT_MS="120000"
# Max output tokens per generation request.
AI_MAX_TOKENS="4096"
# Sampling temperature for generation stages.
AI_TEMPERATURE="0.3"

# --- Upstream throttling -----------------------------------------------------
# The FCC server admits NIM traffic at roughly 1 request / 2s with a
# concurrency of 2, and the NIM upstream returns HTTP 429 when exceeded.
# The client-side queue mirrors that so the pipeline degrades gracefully.
AI_MIN_REQUEST_INTERVAL_MS="2000"
AI_MAX_CONCURRENCY="2"

# --- Development mode --------------------------------------------------------
# "true"  => NO network calls. Deterministic, clearly-labelled fixtures.
#            Every generated record is stamped provider="mock" and the UI shows
#            a "Development fixtures" banner. This is NEVER real NIM output.
# "false" => real FCC/NVIDIA NIM calls (requires FCC_SERVER_API_KEY).
AI_DEV_MODE="true"

# --- Database ----------------------------------------------------------------
# SQLite file, via Node's built-in `node:sqlite` (no native compilation).
# Use ":memory:" for ephemeral/test databases.
DATABASE_FILE="./data/mastery.db"

# --- Uploads -----------------------------------------------------------------
# Directory for uploaded source documents (gitignored).
UPLOAD_DIR="./uploads"
# Max bytes per uploaded file (10 MB).
MAX_UPLOAD_BYTES="10485760"
# Max files per single upload request.
MAX_UPLOAD_FILES="10"

# --- Security ----------------------------------------------------------------
# Secret used to sign the demo session cookie. Generate a real one:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_SECRET="change-me-please-generate-a-random-32-byte-hex-string"

# Requests per minute, per IP, for AI-triggering endpoints.
RATE_LIMIT_PER_MINUTE="20"

# --- Logging -----------------------------------------------------------------
# debug | info | warn | error
LOG_LEVEL="info"
# When true, logs a redacted preview of source text. Off by default because
# uploaded course material may be sensitive.
LOG_SOURCE_PREVIEWS="false"
